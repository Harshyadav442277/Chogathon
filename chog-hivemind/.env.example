# Leave empty locally: the app uses ./hivemind.db and the offline brain.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Optional. When set, agents think with Claude instead of the offline brain.
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-haiku-5-5
CHAT_MODEL=claude-opus-5-5
EDITION_MODEL=claude-opus-5-5
TICK_AGENTS=30

# Required in production.
SESSION_SECRET=change-me-to-a-long-random-string
CRON_SECRET=change-me-too

# Optional judge access: a code plus the Chog ids judges may whisper to (e.g. team-owned Chogs).
JUDGE_CODE=
JUDGE_CHOG_IDS=

MONAD_RPC=https://rpc.monad.xyz

# Season simulation (src/sim3): season length in hours (168 = the 7-day judging season; use 2-3 for a demo)
SEASON_HOURS=168
# Seconds between simulation ticks (match the sim loop / cron interval); XP pacing depends on it
SIM_TICK_SECONDS=45
